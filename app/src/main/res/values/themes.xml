<resources>
    <style name="Theme.Omni" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="omniAccent">@color/accent</item>
        <item name="omniBg">@color/bg</item>
        <item name="omniBrand">@color/brand</item>
        <item name="omniPanel">@color/panel</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textSize">18sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:backgroundTint">?attr/omniAccent</item>
    </style>
    <style name="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Bg.Night">
        <item name="omniBg">#0B1320</item>
        <item name="omniBrand">#123A5A</item>
        <item name="omniPanel">#CC0B1320</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Bg.Black">
        <item name="omniBg">#000000</item>
        <item name="omniBrand">#161616</item>
        <item name="omniPanel">#CC000000</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Bg.Slate">
        <item name="omniBg">#1C1F24</item>
        <item name="omniBrand">#2E3440</item>
        <item name="omniPanel">#CC1C1F24</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Bg.Ocean">
        <item name="omniBg">#04232B</item>
        <item name="omniBrand">#0B4F5C</item>
        <item name="omniPanel">#CC04232B</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Bg.Forest">
        <item name="omniBg">#0E1D14</item>
        <item name="omniBrand">#1E4D2B</item>
        <item name="omniPanel">#CC0E1D14</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Bg.Plum">
        <item name="omniBg">#1A0F24</item>
        <item name="omniBrand">#3D1F5C</item>
        <item name="omniPanel">#CC1A0F24</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Bg.Desert">
        <item name="omniBg">#1F1710</item>
        <item name="omniBrand">#5A3D1E</item>
        <item name="omniPanel">#CC1F1710</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Accent.Orange">
        <item name="omniAccent">#FF9F1C</item>
        <item name="android:colorAccent">#FF9F1C</item>
    </style>
    <style name="Accent.Sky">
        <item name="omniAccent">#4FC3F7</item>
        <item name="android:colorAccent">#4FC3F7</item>
    </style>
    <style name="Accent.Green">
        <item name="omniAccent">#66BB6A</item>
        <item name="android:colorAccent">#66BB6A</item>
    </style>
    <style name="Accent.Pink">
        <item name="omniAccent">#F06292</item>
        <item name="android:colorAccent">#F06292</item>
    </style>
    <style name="Accent.Yellow">
        <item name="omniAccent">#FFD54F</item>
        <item name="android:colorAccent">#FFD54F</item>
    </style>
    <style name="Accent.Red">
        <item name="omniAccent">#EF5350</item>
        <item name="android:colorAccent">#EF5350</item>
    </style>
    <style name="Accent.Violet">
        <item name="omniAccent">#B388FF</item>
        <item name="android:colorAccent">#B388FF</item>
    </style>
    <style name="Accent.Cyan">
        <item name="omniAccent">#26C6DA</item>
        <item name="android:colorAccent">#26C6DA</item>
    </style>
</resources>
