<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#40FFFFFF" /><stroke android:width="3dp" android:color="?attr/omniAccent" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#30FFFFFF" /><stroke android:width="2dp" android:color="?attr/omniAccent" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#1FFFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
