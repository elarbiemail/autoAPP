<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="32dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chaînes YouTube Live"
            android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Collez le lien d'une chaîne (youtube.com/@pseudo) ou d'un direct (youtube.com/watch?v=…). Le direct en cours et les vidéos sont lus dans Omni IPTV (lecteur natif, ou lecteur YouTube intégré en secours)."
            android:textColor="@color/hint" android:textSize="15sp" />
        <EditText android:id="@+id/yt_name" style="@style/Field" android:hint="Nom affiché (ex. : 2M Live)" android:inputType="text" />
        <EditText android:id="@+id/yt_url" style="@style/Field" android:hint="Lien YouTube ou @pseudo" android:inputType="textUri" />
        <EditText android:id="@+id/yt_group" style="@style/Field" android:hint="Catégorie (facultatif, ex. : Info, Coran, Éducation)" android:inputType="text" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button android:id="@+id/yt_add" style="@style/Btn" android:text="Ajouter" />
            <Button android:id="@+id/yt_test" style="@style/Btn" android:text="Tester le direct" />
        </LinearLayout>
        <TextView android:id="@+id/yt_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="@color/accent" android:textSize="16sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Suggestions (directs officiels)" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/yt_presets" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Mes chaînes YouTube (OK : regarder • choisir pour supprimer)" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/yt_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
