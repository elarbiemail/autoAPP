<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <TextView android:id="@+id/info_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/info_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/accent" android:textSize="16sp" />
        <TextView android:id="@+id/info_now" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="18sp" />
        <TextView android:id="@+id/info_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/hint" android:textSize="16sp" />
        <TextView android:id="@+id/info_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/accent" android:textSize="16sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="↑/↓ zapper  •  ← liste des chaînes  •  OK infos  •  OK maintenu : favori"
            android:textColor="@color/hint" android:textSize="13sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/side_list"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:choiceMode="singleChoice"
        android:listSelector="@color/accent"
        android:visibility="gone" />
</FrameLayout>
