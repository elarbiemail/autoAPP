<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <android.media.tv.TvView
        android:id="@+id/tv_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="gone" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true" />

    <!-- Téléphone en portrait : informations, commandes et chaînes sous la vidéo -->
    <LinearLayout
        android:id="@+id/mobile_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/omniBg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mp_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101B2B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">
            <ImageView android:id="@+id/mp_logo" android:layout_width="72dp" android:layout_height="44dp"
                android:layout_marginEnd="12dp" android:scaleType="fitCenter" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/mp_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/mp_now" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="14sp" />
                <ProgressBar android:id="@+id/mp_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp"
                    android:max="100" android:progressTint="?attr/omniAccent" />
                <TextView android:id="@+id/mp_next_prog" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="@color/hint" android:textSize="13sp" />
                <TextView android:id="@+id/mp_tech" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#8FD3FF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#101B2B" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp"
            android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/mp_prev" style="@style/Chip" android:text="◀ Préc." />
                <TextView android:id="@+id/mp_next" style="@style/Chip" android:text="Suiv. ▶" />
                <TextView android:id="@+id/mp_fav" style="@style/Chip" android:text="☆ Favori" />
                <TextView android:id="@+id/mp_quality" style="@style/Chip" android:text="Qualité" />
                <TextView android:id="@+id/mp_full" style="@style/Chip" android:text="⛶ Plein écran" />
                <TextView android:id="@+id/mp_pip" style="@style/Chip" android:text="Réduire" />
                <TextView android:id="@+id/mp_options" style="@style/Chip" android:text="⋯ Options" />
            </LinearLayout>
        </HorizontalScrollView>

        <ListView android:id="@+id/mp_list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:choiceMode="singleChoice" android:divider="#22FFFFFF"
            android:dividerHeight="1dp" android:fastScrollEnabled="true" />
    </LinearLayout>

    <!-- Bandeau d'informations -->
    <LinearLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/omniPanel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="18dp"
        android:paddingEnd="40dp"
        android:paddingBottom="22dp">

        <ImageView
            android:id="@+id/info_logo"
            android:layout_width="150dp"
            android:layout_height="84dp"
            android:layout_marginEnd="24dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/info_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/info_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/omniAccent" android:textSize="15sp" />
            <TextView android:id="@+id/info_now" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="18sp" />
            <ProgressBar android:id="@+id/info_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
                android:max="100" android:progressTint="?attr/omniAccent" />
            <TextView android:id="@+id/info_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/hint" android:textSize="15sp" />
            <TextView android:id="@+id/info_tech" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#8FD3FF" android:textSize="14sp" />
            <TextView android:id="@+id/info_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/omniAccent" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="↑/↓ zapper • ← chaînes • → options et qualité • 0-9 numéro • OK infos • OK maintenu favori"
                android:textColor="@color/hint" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bande des chaînes -->
    <LinearLayout
        android:id="@+id/side"
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:background="#E60B1320"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/side_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:textColor="?attr/omniAccent" android:textSize="18sp" android:textStyle="bold" />
        <ListView android:id="@+id/side_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:choiceMode="singleChoice" android:divider="#22FFFFFF" android:dividerHeight="1dp"
            android:listSelector="?attr/omniAccent" />
    </LinearLayout>

    <!-- Saisie du numéro -->
    <TextView
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="40dp"
        android:background="?attr/omniPanel"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Statistiques de lecture -->
    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="32dp"
        android:background="?attr/omniPanel"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:textColor="#B9F6CA"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
