<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/page_pad_top"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dépôts"
            android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Un dépôt est un fichier JSON en ligne qui regroupe des listes M3U, comptes Xtream, portails MAC, chaînes YouTube Live et autres dépôts. Saisissez son URL ou un raccourci GitHub « utilisateur/dépôt »."
            android:textColor="@color/hint" android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/repo_url" style="@style/Field" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginTop="0dp" android:hint="https://…/depot.json  ou  utilisateur/depot" android:inputType="textUri" />
            <Button android:id="@+id/repo_add" style="@style/Btn" android:layout_marginStart="12dp" android:text="Ajouter" />
            <Button android:id="@+id/repo_refresh" style="@style/Btn" android:text="Tout mettre à jour" />
        </LinearLayout>
        <TextView android:id="@+id/repo_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="?attr/omniAccent" android:textSize="16sp" />
        <LinearLayout android:id="@+id/repo_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
