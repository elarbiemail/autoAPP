<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad"
    android:paddingTop="@dimen/page_pad_top"
    android:paddingEnd="@dimen/page_pad"
    android:paddingBottom="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Listes IPTV gratuites et légales" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Catalogues publics : iptv-org (chaînes en libre accès du monde entier) et Free-TV. Choisissez un catalogue ou cherchez un nom de chaîne."
        android:textColor="@color/hint" android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <EditText android:id="@+id/free_query" style="@style/Field" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginTop="0dp" android:hint="Ex. : 2M, Al Aoula, Medi1, France 24, Al Jazeera, documentaire…"
            android:imeOptions="actionSearch" android:inputType="text" />
        <Button android:id="@+id/btn_free_search" style="@style/Btn" android:layout_marginStart="12dp" android:text="Rechercher" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/free_presets" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btn_free_test" style="@style/Btn" android:text="Tester la disponibilité" />
        <Button android:id="@+id/btn_free_save" style="@style/Btn" android:text="Enregistrer comme source" />
        <Button android:id="@+id/btn_free_catalog" style="@style/Btn" android:text="Suivre ce catalogue (mise à jour auto)" />
    </LinearLayout>
    </HorizontalScrollView>

    <TextView android:id="@+id/free_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/accent" android:textSize="15sp" />

    <ListView android:id="@+id/free_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="6dp" android:layout_weight="1" android:listSelector="@color/accent" />
</LinearLayout>
