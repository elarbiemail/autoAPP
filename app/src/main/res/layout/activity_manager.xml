<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad"
    android:paddingTop="@dimen/page_pad_top"
    android:paddingEnd="@dimen/page_pad"
    android:paddingBottom="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestionnaire de chaînes"
        android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Groupes à gauche (OK : monter, descendre, renommer, masquer) • chaînes à droite (OK : renommer, déplacer, masquer, guide TV, logo)"
        android:textColor="@color/hint" android:textSize="13sp" />

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/mg_source" style="@style/Btn" android:text="Source" />
        <Button android:id="@+id/mg_logos" style="@style/Btn" android:text="Compléter les logos" />
        <Button android:id="@+id/mg_prefetch" style="@style/Btn" android:text="Télécharger les icônes" />
        <Button android:id="@+id/mg_epg" style="@style/Btn" android:text="Guides TV" />
        <Button android:id="@+id/mg_reset" style="@style/Btn" android:text="Réinitialiser" />
    </LinearLayout>
    </HorizontalScrollView>

    <TextView android:id="@+id/mg_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="?attr/omniAccent" android:textSize="15sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp"
        android:layout_weight="1" android:orientation="horizontal">
        <ListView android:id="@+id/mg_groups" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="#22FFFFFF" android:choiceMode="singleChoice"
            android:listSelector="?attr/omniAccent" />
        <ListView android:id="@+id/mg_channels" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginStart="16dp" android:layout_weight="2" android:background="#22FFFFFF"
            android:listSelector="?attr/omniAccent" />
    </LinearLayout>
</LinearLayout>
