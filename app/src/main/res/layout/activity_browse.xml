<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad"
    android:paddingTop="@dimen/page_pad_top"
    android:paddingEnd="@dimen/page_pad"
    android:paddingBottom="8dp">

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/br_tabs" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView android:id="@+id/br_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/hint" android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp"
        android:layout_weight="1" android:orientation="horizontal">
        <ListView android:id="@+id/br_groups" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="#22FFFFFF" android:choiceMode="singleChoice"
            android:listSelector="@color/accent" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="14dp"
            android:layout_weight="3">
            <ListView android:id="@+id/br_list" android:layout_width="match_parent" android:layout_height="match_parent"
                android:listSelector="@color/accent" />
            <GridView android:id="@+id/br_grid" android:layout_width="match_parent" android:layout_height="match_parent"
                android:columnWidth="190dp" android:horizontalSpacing="10dp" android:listSelector="@color/accent"
                android:numColumns="auto_fit" android:stretchMode="columnWidth" android:verticalSpacing="10dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
