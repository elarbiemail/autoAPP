<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="24dp"
    android:paddingEnd="48dp"
    android:paddingBottom="16dp">
    <TextView android:id="@+id/se_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button android:id="@+id/se_resume" style="@style/Btn" android:text="Reprendre" />
        <Button android:id="@+id/se_watch" style="@style/Btn" android:text="À regarder" />
    </LinearLayout>
    <TextView android:id="@+id/se_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/accent" android:textSize="15sp" />
    <ListView android:id="@+id/se_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="6dp" android:layout_weight="1" android:listSelector="@color/accent" />
</LinearLayout>
