<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/page_pad_top"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Guides TV (EPG)"
            android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/epg_info" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/hint" android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/epg_url" style="@style/Field" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginTop="0dp" android:hint="URL d'un guide XMLTV (.xml ou .xml.gz)" android:inputType="textUri" />
            <Button android:id="@+id/epg_add" style="@style/Btn" android:layout_marginStart="12dp" android:text="Ajouter" />
            <Button android:id="@+id/epg_update" style="@style/Btn" android:text="Mettre à jour" />
        </LinearLayout>
        <TextView android:id="@+id/epg_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="?attr/omniAccent" android:textSize="16sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="Mes guides supplémentaires (OK pour retirer)" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/epg_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="Guides publics suggérés (epgshare01)" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/epg_suggest" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
