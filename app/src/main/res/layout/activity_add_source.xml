<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="32dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp">

        <TextView android:id="@+id/form_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/form_help" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/hint" android:textSize="15sp" />

        <EditText android:id="@+id/f_name" style="@style/Field" android:hint="Nom de la source (facultatif)" android:inputType="text" />
        <EditText android:id="@+id/f_url" style="@style/Field" android:inputType="textUri" />
        <EditText android:id="@+id/f_user" style="@style/Field" android:hint="Nom d'utilisateur" android:inputType="text" />
        <EditText android:id="@+id/f_pass" style="@style/Field" android:hint="Mot de passe" android:inputType="textVisiblePassword" />

        <LinearLayout android:id="@+id/mac_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/f_mac" style="@style/Field" android:layout_width="0dp" android:layout_weight="1"
                android:hint="Adresse MAC (00:1A:79:XX:XX:XX)" android:inputType="textCapCharacters" />
            <Button android:id="@+id/btn_mac" style="@style/Btn" android:layout_marginStart="12dp" android:text="Générer" />
        </LinearLayout>

        <EditText android:id="@+id/f_epg" style="@style/Field" android:hint="URL du guide TV XMLTV (facultatif, .xml ou .xml.gz)" android:inputType="textUri" />
        <EditText android:id="@+id/f_ua" style="@style/Field" android:hint="User-Agent personnalisé (facultatif)" android:inputType="text" />

        <TextView android:id="@+id/form_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/accent" android:textSize="16sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_save" style="@style/Btn" android:text="Enregistrer et charger" />
            <Button android:id="@+id/btn_cancel" style="@style/Btn" android:text="Annuler" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
